{
  "description": "Apartments within 500 m of Ribeira (Porto): the name and description matter, the filter does the geography.",
  "query": "apartamento",
  "params": {
    "pt": "41.1406,-8.6139"
  },
  "filter": [
    "doc_type:listing",
    "city:porto",
    "{!geofilt sfield=location pt=$pt d=0.5}"
  ],
  "fields": "id,name,price,room_type,property_type,location,listing_url,dist:geodist(location,41.1406,-8.6139),score",
  "limit": 10
}